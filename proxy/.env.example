# Copy to .env and fill in. .env is gitignored — never commit real values.

# Shared secret the Vercel app must send as: Authorization: Bearer <token>
ERPNEXT_PROXY_TOKEN=change-me

# Local ERPNext instance
ERPNEXT_URL=http://localhost:8080
ERPNEXT_API_KEY=your-api-key
ERPNEXT_API_SECRET=your-api-secret

# CORS origins allowed to call the proxy directly (comma-separated).
ALLOWED_ORIGINS=*
